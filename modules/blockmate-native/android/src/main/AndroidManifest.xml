<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <application>
    <service
      android:name="com.blockmate.nativebridge.BlockMateAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true"
      android:label="@string/blockmate_accessibility_label">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/blockmate_accessibility_config" />
    </service>
    <service
      android:name="com.blockmate.nativebridge.BlockMateScreenCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
  </application>
</manifest>
